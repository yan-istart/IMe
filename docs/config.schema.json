{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMe Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataDir": {
      "type": "string",
      "minLength": 1
    },
    "allowApps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "taskDefaultLimit": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "default": "1000000"
    },
    "budgetTimezone": {
      "type": "string"
    },
    "desktopLeasePath": {
      "type": "string"
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "maxCharacters": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32000
        },
        "recentActions": {
          "type": "integer",
          "minimum": 1
        },
        "memoryLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "skillLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pressureThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "maxInjectedTokens": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        }
      },
      "additionalProperties": false
    },
    "vision": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxKeyframesPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "retentionMs": {
          "type": "integer",
          "minimum": 0
        },
        "storeFrames": {
          "type": "boolean",
          "default": false
        },
        "roi": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "redact": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "sampleFps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "adaptive": {
          "type": "boolean",
          "default": false
        },
        "stableWindowMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "states": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "regions"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "roi",
                    "mean",
                    "tolerance"
                  ],
                  "properties": {
                    "roi": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    },
                    "mean": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "tolerance": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 255
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "app",
        "cases"
      ],
      "additionalProperties": false
    },
    "learning": {
      "type": "object",
      "properties": {
        "minSuccesses": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "default": 3
        },
        "autoPublish": {
          "type": "boolean",
          "default": false
        },
        "captureHostExperience": {
          "type": "boolean",
          "default": true
        },
        "captureToolPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "maintenance": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "budgetCaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "session",
              "day",
              "account"
            ]
          },
          "key": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "limit": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "scope",
          "key",
          "currency",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "modelBudget": {
      "type": "object",
      "properties": {
        "sessionLimit": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "inputUpperBound": {
                "type": "integer",
                "minimum": 1
              },
              "maxOutput": {
                "type": "integer",
                "minimum": 1
              },
              "price": {
                "$ref": "#/$defs/price"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time",
                "description": "Reject this route after its tariff validity window ends."
              }
            },
            "required": [
              "provider",
              "model",
              "inputUpperBound",
              "maxOutput",
              "price"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sessionLimit",
        "routes"
      ],
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "cheap",
              "standard",
              "strong"
            ]
          },
          "vision": {
            "type": "boolean"
          },
          "tools": {
            "type": "boolean"
          },
          "contextLimit": {
            "type": "integer",
            "minimum": 1
          },
          "maxOutput": {
            "type": "integer",
            "minimum": 1
          },
          "privacyRegion": {
            "type": "string"
          },
          "price": {
            "$ref": "#/$defs/price"
          },
          "requestsPerMinute": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "provider",
          "model",
          "tier",
          "vision",
          "tools",
          "contextLimit",
          "maxOutput",
          "privacyRegion",
          "price"
        ]
      }
    },
    "desktopAdapter": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "toolPrefix": {
          "type": "string",
          "minLength": 1
        },
        "observeTool": {
          "type": "string"
        },
        "executeTools": {
          "type": "object",
          "properties": {
            "click": {
              "type": "string"
            },
            "input": {
              "type": "string"
            },
            "scroll": {
              "type": "string"
            }
          },
          "required": [
            "click",
            "input",
            "scroll"
          ]
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "observeArgs": {
                "type": "object"
              },
              "fingerprintPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "statePath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "actions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "click",
                        "input",
                        "scroll"
                      ]
                    },
                    "args": {
                      "type": "object"
                    },
                    "risk": {
                      "enum": [
                        "read_only",
                        "reversible_write",
                        "sensitive_write",
                        "irreversible"
                      ]
                    },
                    "expectedState": {
                      "type": "string"
                    },
                    "precondition": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "args",
                    "risk",
                    "expectedState"
                  ]
                }
              },
              "evaluation": {
                "type": "object",
                "properties": {
                  "resetTool": {
                    "type": "string"
                  },
                  "cases": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object"
                    }
                  }
                }
              },
              "framePath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "window": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "allow"
                ],
                "properties": {
                  "path": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "allow": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "permissionPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pngPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "attachmentPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "observeArgs",
              "fingerprintPath",
              "statePath",
              "actions"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "framePath",
                    "pngPath"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "framePath",
                    "attachmentPath"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "pngPath",
                    "attachmentPath"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "provider",
        "toolPrefix",
        "observeTool",
        "executeTools",
        "targets"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxConsecutive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 3
        },
        "minIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000,
          "default": 1500
        }
      }
    },
    "adaptiveTaskBudget": {
      "type": "boolean",
      "default": false
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 256,
          "default": 8388608
        },
        "retainedFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 3
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "privacyRegion": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "maxOutput"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "maxOutput": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "vision": {
          "type": "boolean",
          "default": false
        },
        "http": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "model",
              "endpoint",
              "inputOverheadTokens"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "format": "uri"
              },
              "credentialEnv": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
              },
              "inputOverheadTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "maxResponseBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 16777216
              }
            }
          }
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "keyEnv"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "keyEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "authorizationEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authorizationEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "autoFlushMs": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "desktopAdapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/properties/desktopAdapter"
      }
    }
  },
  "$defs": {
    "price": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "inputPerMillion": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "cachedPerMillion": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "outputPerMillion": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "version",
        "currency",
        "inputPerMillion",
        "cachedPerMillion",
        "outputPerMillion"
      ],
      "additionalProperties": false
    }
  }
}
