{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMe Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataDir": {
      "type": "string",
      "minLength": 1
    },
    "allowApps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "taskDefaultLimit": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "default": "1000000"
    },
    "budgetTimezone": {
      "type": "string"
    },
    "desktopLeasePath": {
      "type": "string"
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "maxCharacters": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32000
        },
        "recentActions": {
          "type": "integer",
          "minimum": 1
        },
        "memoryLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "skillLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pressureThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    },
    "vision": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxKeyframesPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "retentionMs": {
          "type": "integer",
          "minimum": 0
        },
        "storeFrames": {
          "type": "boolean",
          "default": false
        },
        "roi": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "redact": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "app",
        "cases"
      ],
      "additionalProperties": false
    },
    "learning": {
      "type": "object",
      "properties": {
        "minSuccesses": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "default": 3
        },
        "autoPublish": {
          "type": "boolean",
          "default": false
        },
        "captureHostExperience": {
          "type": "boolean",
          "default": true
        },
        "captureToolPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "budgetCaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "session",
              "day",
              "account"
            ]
          },
          "key": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "limit": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "scope",
          "key",
          "currency",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "modelBudget": {
      "type": "object",
      "properties": {
        "sessionLimit": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "inputUpperBound": {
                "type": "integer",
                "minimum": 1
              },
              "maxOutput": {
                "type": "integer",
                "minimum": 1
              },
              "price": {
                "$ref": "#/$defs/price"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time",
                "description": "Reject this route after its tariff validity window ends."
              }
            },
            "required": [
              "provider",
              "model",
              "inputUpperBound",
              "maxOutput",
              "price"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sessionLimit",
        "routes"
      ],
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "cheap",
              "standard",
              "strong"
            ]
          },
          "vision": {
            "type": "boolean"
          },
          "tools": {
            "type": "boolean"
          },
          "contextLimit": {
            "type": "integer",
            "minimum": 1
          },
          "maxOutput": {
            "type": "integer",
            "minimum": 1
          },
          "privacyRegion": {
            "type": "string"
          },
          "price": {
            "$ref": "#/$defs/price"
          }
        },
        "required": [
          "provider",
          "model",
          "tier",
          "vision",
          "tools",
          "contextLimit",
          "maxOutput",
          "privacyRegion",
          "price"
        ]
      }
    },
    "desktopAdapter": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "toolPrefix": {
          "type": "string",
          "minLength": 1
        },
        "observeTool": {
          "type": "string"
        },
        "executeTools": {
          "type": "object",
          "properties": {
            "click": {
              "type": "string"
            },
            "input": {
              "type": "string"
            },
            "scroll": {
              "type": "string"
            }
          },
          "required": [
            "click",
            "input",
            "scroll"
          ]
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "observeArgs": {
                "type": "object"
              },
              "fingerprintPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "statePath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "actions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "click",
                        "input",
                        "scroll"
                      ]
                    },
                    "args": {
                      "type": "object"
                    },
                    "risk": {
                      "enum": [
                        "read_only",
                        "reversible_write",
                        "sensitive_write",
                        "irreversible"
                      ]
                    },
                    "expectedState": {
                      "type": "string"
                    },
                    "precondition": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "args",
                    "risk",
                    "expectedState"
                  ]
                }
              },
              "evaluation": {
                "type": "object",
                "properties": {
                  "resetTool": {
                    "type": "string"
                  },
                  "cases": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object"
                    }
                  }
                }
              },
              "framePath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "observeArgs",
              "fingerprintPath",
              "statePath",
              "actions"
            ]
          }
        }
      },
      "required": [
        "provider",
        "toolPrefix",
        "observeTool",
        "executeTools",
        "targets"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxConsecutive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 3
        },
        "minIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000,
          "default": 1500
        }
      }
    }
  },
  "$defs": {
    "price": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "inputPerMillion": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "cachedPerMillion": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "outputPerMillion": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "version",
        "currency",
        "inputPerMillion",
        "cachedPerMillion",
        "outputPerMillion"
      ],
      "additionalProperties": false
    }
  }
}
